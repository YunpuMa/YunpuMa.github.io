<!-- Metadata, OpenGraph and Schema.org -->
{% include metadata.liquid %}

<!-- Security: Content Security Policy -->
<!-- Permissive CSP suitable for academic websites. Allows external images, videos, and common embed services. -->
<!-- To customize for your needs, see: https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP -->
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;"
>
<style>
  :root {
    --max-content-width: {{ site.max_width | default: '930px' }};
  }
</style>

<!-- Tailwind-first core styles -->
<link rel="stylesheet" href="{{ '/assets/css/tailwind.css' | relative_url | bust_file_cache }}">

{% if site.al_folio.compat.bootstrap.enabled %}
  <!-- Optional Bootstrap compatibility layer -->
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap-compat.css' | relative_url | bust_file_cache }}">
{% endif %}

{% if page.pretty_table and site.al_folio.compat.bootstrap.enabled %}
  <!-- Bootstrap Table -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.bootstrap-table.url.css }}"
    integrity="{{ site.third_party_libraries.bootstrap-table.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.toc and page.toc.sidebar %}
  <!-- Tocbot -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.tocbot.url.css }}"
    integrity="{{ site.third_party_libraries.tocbot.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

<!-- Icons -->
{% if site.plugins contains 'al_icons' %}
  {% include plugins/al_icons_styles.liquid %}
{% endif %}
<link
  defer
  rel="stylesheet"
  type="text/css"
  href="{{ site.third_party_libraries.google_fonts.url.fonts }}"
>

<!-- Code Syntax Highlighting -->
<link
  defer
  rel="stylesheet"
  href="{{ '/assets/css/jekyll-pygments-themes-github.css' | relative_url | bust_file_cache }}"
  media=""
  id="highlight_theme_light"
>

<!-- Styles -->

{% if page.pseudocode %}
  <!-- pseudocode -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.pseudocode.url.css }}"
    integrity="{{ site.third_party_libraries.pseudocode.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.icon.size <= 4 %}
  <link
    rel="shortcut icon"
    href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
  >
{% elsif site.icon != blank %}
  <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url | bust_file_cache}}">
{% endif %}
<link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">
{% if page.layout == 'cv' and site.plugins contains 'al_folio_cv' and site.al_folio.features.cv.enabled != false %}
  <link rel="stylesheet" href="{{ '/assets/css/al-folio-cv.css' | relative_url | bust_file_cache }}">
{% endif %}
<link rel="canonical" href="{{ page.url | replace:'index.html','' | absolute_url }}">

{% if site.enable_darkmode %}
  <!-- Dark Mode -->
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  <link
    defer
    rel="stylesheet"
    href="{{ '/assets/css/jekyll-pygments-themes-native.css' | relative_url | bust_file_cache }}"
    media="none"
    id="highlight_theme_dark"
  >
  <script>
    initTheme();
  </script>
{% endif %}

{% if page.map %}
  <!-- GeoJSON support via Leaflet -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.leaflet.url.css }}"
    integrity="{{ site.third_party_libraries.leaflet.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if page.code_diff %}
  <!-- diff2html -->
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.light }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.light }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: light)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.highlightjs.url.css.dark }}"
    integrity="{{ site.third_party_libraries.highlightjs.integrity.css.dark }}"
    crossorigin="anonymous"
    media="screen and (prefers-color-scheme: dark)"
  >
  <link
    defer
    rel="stylesheet"
    href="{{ site.third_party_libraries.diff2html.url.css }}"
    integrity="{{ site.third_party_libraries.diff2html.integrity.css }}"
    crossorigin="anonymous"
  >
{% endif %}

{% if site.plugins contains 'al_img_tools' %}
  <!-- Image Features -->
  {% include plugins/al_img_tools_styles.liquid %}
{% endif %}

{% if site.plugins contains 'al_math' %}
  {% include plugins/al_math_styles.liquid %}
{% endif %}

{% if site.enable_cookie_consent and site.plugins contains 'al_cookie' %}
  <!-- Cookie Consent -->
  {% include plugins/al_cookie_styles.liquid %}
{% endif %}

<!-- Site-wide style overrides: loaded in <head> to prevent FOUC -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,400&display=optional">
<style>
  :root {
    --global-theme-color: #4e6fa3;
    --global-hover-color: #3d5a87;
    --global-code-bg-color: rgba(78, 111, 163, 0.07);
    --global-bg-color: #f5f7fa;
    --global-heading-color: #2d3748;
  }
  html[data-theme=dark] {
    --global-theme-color: #7a9fc4;
    --global-hover-color: #6a8fb5;
    --global-heading-color: var(--global-text-color);
  }
  html[data-theme=dark] a.navbar-brand.title::before {
    color: #cbd5e1;
  }
  html[data-theme=dark] body {
    background-image:
      radial-gradient(ellipse 65% 55% at 12% 18%, rgba(122, 159, 196, 0.09) 0%, transparent 65%),
      radial-gradient(ellipse 55% 65% at 88% 82%, rgba(122, 159, 196, 0.06) 0%, transparent 65%),
      radial-gradient(ellipse 40% 40% at 58% 38%, rgba(90, 130, 180, 0.04) 0%, transparent 60%);
  }
  html[data-theme=dark] .navbar {
    background-color: rgba(28, 28, 29, 0.72) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07) !important;
    box-shadow: 0 2px 24px rgba(0, 0, 0, 0.25), inset 0 -1px 0 rgba(255, 255, 255, 0.04) !important;
  }
  body {
    font-family: 'DM Sans', sans-serif;
    background-image:
      radial-gradient(ellipse 65% 55% at 12% 18%, rgba(78, 111, 163, 0.13) 0%, transparent 65%),
      radial-gradient(ellipse 55% 65% at 88% 82%, rgba(78, 111, 163, 0.09) 0%, transparent 65%),
      radial-gradient(ellipse 40% 40% at 58% 38%, rgba(100, 140, 200, 0.06) 0%, transparent 60%);
    background-attachment: fixed;
  }
  h1, h2, h3 { font-family: 'Libre Baskerville', serif; font-weight: 700; color: var(--global-heading-color); }
  .post-title { letter-spacing: 0.01em; }
  #about-name-prefix { font-size: 0.55em; font-weight: 400; }
  #about-name { font-family: 'Cormorant Garamond', serif; font-size: 1.35em; font-weight: 400; font-style: italic; color: var(--global-theme-color); }
  .navbar-brand { font-family: 'Libre Baskerville', serif; font-weight: 400; }
  a.navbar-brand.title {
    color: var(--global-theme-color) !important;
    display: inline-flex;
    align-items: baseline;
    gap: 0.18rem;
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: 0;
    font-style: normal;
    font-weight: 400 !important;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  a.navbar-brand.title::before {
    content: "Dr.";
    color: #000;
    font-family: 'Libre Baskerville', Georgia, 'Times New Roman', serif;
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
  }
  a.navbar-brand.title::after {
    content: "Yunpu Ma";
    color: var(--global-theme-color);
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: 1.42rem;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  a.navbar-brand.title:hover,
  a.navbar-brand.title:focus-visible {
    text-decoration: none;
  }
  a.navbar-brand.title:hover::after,
  a.navbar-brand.title:focus-visible::after {
    color: var(--global-hover-color);
  }
  .navbar {
    background-color: rgba(245, 247, 250, 0.72) !important;
    backdrop-filter: blur(20px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
    opacity: 1 !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.55) !important;
    box-shadow: 0 2px 24px rgba(78, 111, 163, 0.08), inset 0 -1px 0 rgba(255, 255, 255, 0.4) !important;
  }
  /* Publications: glass card lift + dim siblings on hover */
  .bibliography li {
    position: relative;
    padding: 0.4rem 0.6rem;
    border-radius: 0.6rem;
    transition: box-shadow 0.22s ease, background 0.22s ease;
  }
  .bibliography li:hover {
    background: linear-gradient(
      120deg,
      rgba(78, 111, 163, 0.10) 0%,
      rgba(78, 111, 163, 0.03) 50%,
      rgba(78, 111, 163, 0.08) 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 -1px 0 rgba(255, 255, 255, 0.25),
      0 4px 20px rgba(78, 111, 163, 0.1);
  }
  html[data-theme=dark] .bibliography li:hover {
    background: linear-gradient(
      120deg,
      rgba(122, 159, 196, 0.12) 0%,
      rgba(122, 159, 196, 0.04) 50%,
      rgba(122, 159, 196, 0.10) 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05),
      0 4px 20px rgba(0, 0, 0, 0.25);
  }
  @media (prefers-reduced-motion: reduce) {
    .bibliography li { transition: none; }
  }
  /* Navbar: zoom on hover */
  .navbar.navbar-light .navbar-brand.social a {
    display: inline-block;
    transform: translateZ(0) scale(1);
    transition: transform 0.18s ease;
  }
  .navbar.navbar-light .navbar-brand.social a:hover {
    transform: translateZ(0) scale(1.22);
  }
  .navbar.navbar-light .navbar-nav .nav-item .nav-link {
    transform: translateZ(0) scale(1);
    transition: transform 0.18s ease, color 0.18s ease;
  }
  .navbar.navbar-light .navbar-nav .nav-item .nav-link:hover {
    transform: translateZ(0) scale(1.08);
  }
  #light-toggle {
    transform: translateY(4px) translateZ(0) scale(1);
    transition: transform 0.18s ease;
  }
  #light-toggle:hover {
    transform: translateY(4px) translateZ(0) scale(1.18);
  }
  /* Publication buttons: muted theme */
  .bibliography li .links a.btn {
    color: color-mix(in srgb, var(--global-theme-color) 65%, var(--global-text-color-light)) !important;
    border: 1px solid rgba(0, 0, 0, 0.13) !important;
    background: rgba(78, 111, 163, 0.03) !important;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }
  html[data-theme=dark] .bibliography li .links a.btn {
    border-color: rgba(255, 255, 255, 0.15) !important;
    background: rgba(122, 159, 196, 0.05) !important;
  }
  .bibliography li .links a.btn:hover {
    color: var(--global-theme-color) !important;
    border-color: rgba(78, 111, 163, 0.4) !important;
    background: rgba(78, 111, 163, 0.08) !important;
  }
  /* About page: reserve profile image space before image loads */
  .profile picture { display: block; aspect-ratio: 360 / 480; }
  .profile img { width: 100%; height: auto; }
  /* Page transition: veil overlay fades out so page content opacity stays at 1 (avoids anti-aliasing flicker on text) */
  #page-veil {
    position: fixed;
    inset: 0;
    background: var(--global-bg-color);
    z-index: 9998;
    pointer-events: none;
    animation: veil-out 0.28s ease forwards;
  }
  @keyframes veil-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    #page-veil { animation: none; opacity: 0; }
  }
</style>
